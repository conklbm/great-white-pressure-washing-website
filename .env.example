# Server-only configuration. Set real values in Vercel
# (Project → Settings → Environment Variables). NEVER commit real values —
# this repo is public. Copy to .env.local for local dev (git-ignored).

# Where normalized leads (form submissions AND calls) are appended — your
# Google Sheet webhook (a Make.com scenario URL or Apps Script Web App URL).
# Preferred over the site.ts value because it keeps the URL out of the public
# repo. If unset, the app falls back to siteConfig.leadWebhookUrl.
LEAD_WEBHOOK_URL=

# The renter's real phone line that the tracking number forwards to, in E.164
# format (e.g. +12515551234). Kept here, not in code, because it's the
# renter's private number. Empty = the Twilio voice endpoint plays a holding
# message + records voicemail instead of forwarding (Phase 1 / pre-renter).
RENTER_FORWARD_NUMBER=

# Twilio account Auth Token — used ONLY to verify inbound webhooks genuinely
# come from Twilio (X-Twilio-Signature). Find it in the Twilio Console.
# If unset, signature checks are skipped (fine for local testing; SET IT in
# production so nobody can spoof calls into your lead sheet).
TWILIO_AUTH_TOKEN=
